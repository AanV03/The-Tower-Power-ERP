# Database Foundation
# These are examples only. Do not commit real credentials.

DATABASE_URL="postgresql://user:password@localhost:5432/gerpy"
MONGODB_URI="mongodb://localhost:27017/gerpy"

# Optional for future migration workflows that need a direct database URL.
# Prefer this for Prisma CLI commands such as db push/migrate against Supabase.
DIRECT_URL=""

# Auth.js. Generate a real secret locally with: `openssl rand -base64 32`
AUTH_SECRET=""

# Optional OAuth providers for Phase 2.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
