# Database Foundation
# These are examples only. Do not commit real credentials.

DATABASE_URL="postgresql://postgres:change-me@localhost:5432/gerpy"
MONGODB_URI="mongodb://localhost:27017/gerpy"

# Optional for future migration workflows that need a direct database URL.
# Prefer this for Prisma CLI commands such as db push/migrate against Supabase.
DIRECT_URL="postgresql://postgres:change-me@localhost:5432/gerpy"

# Auth.js. Generate a real secret locally with: `openssl rand -base64 32`
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Optional OAuth providers for Phase 2.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Signed outbox worker trigger.
INTEGRATIONS_WEBHOOK_SECRET="replace-with-an-independent-32-character-secret"

# Vercel Cron authorization. Use at least 16 random characters.
CRON_SECRET="replace-with-a-random-cron-secret"

# Signed outbound webhook delivery.
OUTBOX_WEBHOOK_URL="https://integrations.example.com/webhooks/gerpy"
OUTBOX_WEBHOOK_SECRET="replace-with-an-independent-32-character-secret"
