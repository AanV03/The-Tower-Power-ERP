{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/es",
        "http://localhost:3000/en",
        "http://localhost:3000/es/dashboard",
        "http://localhost:3000/en/dashboard",
        "http://localhost:3000/es/access",
        "http://localhost:3000/en/access",
        "http://localhost:3000/es/admin",
        "http://localhost:3000/en/admin",
        "http://localhost:3000/es/finance",
        "http://localhost:3000/en/finance",
        "http://localhost:3000/es/hr",
        "http://localhost:3000/en/hr",
        "http://localhost:3000/es/inventory",
        "http://localhost:3000/en/inventory",
        "http://localhost:3000/es/marketing",
        "http://localhost:3000/en/marketing",
        "http://localhost:3000/es/memberships",
        "http://localhost:3000/en/memberships",
        "http://localhost:3000/es/pos",
        "http://localhost:3000/en/pos",
        "http://localhost:3000/es/specialists",
        "http://localhost:3000/es/integrations",
        "http://localhost:3000/en/integrations"
      ],
      "numberOfRuns": 1,
      "puppeteerScript": "./scripts/lhci-login.js",
      "puppeteerLaunchOptions": {
        "args": [
          "--no-sandbox",
          "--disable-setuid-sandbox",
          "--disable-gpu"
        ]
      },
      "disableStorageReset": true
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}