{
  "name": "the-tower-power-gym-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:check-env": "node scripts/check-env.mjs",
    "db:seed:dev": "node scripts/seed-dev.mjs",
    "test:db-env": "node --test scripts/check-env.test.mjs",
    "test:auth": "node --experimental-strip-types --test scripts/auth-password.test.mjs scripts/rbac.test.mjs",
    "test:api": "node --experimental-strip-types --test scripts/api.test.mjs scripts/navigation.test.mjs scripts/maintenance.test.mjs scripts/seed-dev.test.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:accessibility": "pa11y http://localhost:3000",
    "check:accessibility:all": "node scripts/run-pa11y.js",
    "lhci:update-urls": "node scripts/update-lhci-urls.js",
    "lhci:mobile": "lhci autorun --config=lighthouserc.json --collect.settings.formFactor=mobile",
    "lhci:all": "pnpm run lhci:update-urls && pnpm run lhci:mobile"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@base-ui/react": "^1.4.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.1.2",
    "@vercel/speed-insights": "^2.0.0",
    "animejs": "^4.4.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^0.468.0",
    "mongoose": "^9.6.3",
    "next": "^15.1.3",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.4",
    "otplib": "^13.4.1",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/animejs": "^3.1.13",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "pa11y": "^9.1.1",
    "postcss": "^8.4.49",
    "prisma": "^7.8.0",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.7.2"
  }
}
