generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                        String                     @id @default(cuid())
  name                      String
  legalName                 String?
  taxId                     String?
  status                    TenantStatus               @default(ACTIVE)
  planId                    String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  brandColors               Json?
  brandIdentity             Json?
  accessDevices             AccessDevice[]
  auditLogs                 AuditLog[]
  attendanceRecords         AttendanceRecord[]
  branchMemberships         BranchMembership[]
  branchBudgets             BranchBudget[]
  branches                  Branch[]
  cashSessions              CashSession[]
  chartAccounts             ChartAccount[]
  employeeContracts         EmployeeContract[]
  employees                 Employee[]
  inventoryItems            InventoryItem[]
  inventoryMovements        InventoryMovement[]
  invoiceItems              InvoiceItem[]
  invoices                  Invoice[]
  journalEntries            JournalEntry[]
  journalEntryLines         JournalEntryLine[]
  members                   Member[]
  memberships               TenantMembership[]
  membershipPlans           MembershipPlan[]
  outboxEvents              OutboxEvent[]
  paymentGatewayEvents      PaymentGatewayEvent[]
  payments                  Payment[]
  payrollItems              PayrollItem[]
  payrollPeriods            PayrollPeriod[]
  posRegisters              PosRegister[]
  positions                 Position[]
  productCategories         ProductCategory[]
  products                  Product[]
  roleAssignments           RoleAssignment[]
  roles                     Role[]
  saleItems                 SaleItem[]
  sales                     Sale[]
  securityEvents            SecurityEvent[]
  specialistCommissions     SpecialistCommission[]
  specialistContracts       SpecialistContract[]
  specialistServices        SpecialistService[]
  specialistSessions        SpecialistSession[]
  specialistSettlementItems SpecialistSettlementItem[]
  specialistSettlements     SpecialistSettlement[]
  specialists               Specialist[]
  subscriptionCancellations SubscriptionCancellation[]
  subscriptionPauses        SubscriptionPause[]
  subscriptions             Subscription[]
  suppliers                 Supplier[]
  modules                   TenantModule[]
  plan                      SaasPlan?                  @relation(fields: [planId], references: [id])
  timeClocks                TimeClock[]
  userInvitations           UserInvitation[]
  warehouses                Warehouse[]

  @@index([status])
  @@map("tenants")
}

model SaasPlan {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  price       Decimal      @db.Decimal(12, 2)
  currency    String       @default("MXN")
  interval    PlanInterval @default(MONTHLY)
  limits      Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenants     Tenant[]

  @@map("saas_plans")
}

model TenantModule {
  id        String    @id @default(cuid())
  tenantId  String
  moduleKey ModuleKey
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
  @@index([tenantId, enabled])
  @@map("tenant_modules")
}

model Branch {
  id                 String              @id @default(cuid())
  tenantId           String
  name               String
  code               String
  address            Json?
  timezone           String              @default("America/Mexico_City")
  status             BranchStatus        @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accessDevices      AccessDevice[]
  auditLogs          AuditLog[]
  attendanceRecords  AttendanceRecord[]
  branchBudgets      BranchBudget[]
  branchMemberships  BranchMembership[]
  defaultMemberships TenantMembership[]  @relation("TenantMembershipDefaultBranch")
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees          Employee[]
  invoices           Invoice[]
  members            Member[]
  payments           Payment[]
  posRegisters       PosRegister[]
  roleAssignments    RoleAssignment[]
  sales              Sale[]
  specialistSessions SpecialistSession[]
  specialists        Specialist[]
  timeClocks         TimeClock[]
  warehouses         Warehouse[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("branches")
}

model User {
  id                         String                     @id @default(cuid())
  name                       String?
  firstName                  String?
  lastName                   String?
  phone                      String?
  email                      String?                    @unique
  emailVerified              DateTime?
  image                      String?
  passwordHash               String?
  status                     UserStatus                 @default(INVITED)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  accounts                   Account[]
  mfaCredentials             MfaCredential[]
  recoveryCodes              RecoveryCode[]
  closedCashSessions         CashSession[]              @relation("CashSessionClosedBy")
  openedCashSessions         CashSession[]              @relation("CashSessionOpenedBy")
  memberships                TenantMembership[]
  sessions                   Session[]
  cancelledSubscriptions     SubscriptionCancellation[] @relation("SubscriptionCancellationActor")
  approvedSubscriptionPauses SubscriptionPause[]        @relation("SubscriptionPauseApprover")

  @@index([status])
  @@map("users")
}

model TenantMembership {
  id                      String             @id @default(cuid())
  tenantId                String
  userId                  String
  defaultBranchId         String?
  employeeId              String?
  status                  MembershipStatus   @default(INVITED)
  joinedAt                DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  assignedRoleAssignments RoleAssignment[]   @relation("RoleAssignmentActor")
  auditLogs               AuditLog[]         @relation("AuditLogActor")
  branchMemberships       BranchMembership[]
  defaultBranch           Branch?            @relation("TenantMembershipDefaultBranch", fields: [tenantId, defaultBranchId], references: [tenantId, id])
  employee                Employee?          @relation(fields: [tenantId, employeeId], references: [tenantId, id])
  roleAssignments         RoleAssignment[]   @relation("RoleAssignmentMember")
  securityEvents          SecurityEvent[]
  sessions                Session[]
  sentInvitations         UserInvitation[]   @relation("InvitationActor")
  tenant                  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@unique([tenantId, employeeId])
  @@index([userId, status])
  @@index([tenantId, status])
  @@map("tenant_memberships")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String            @id @default(cuid())
  sessionToken String            @unique
  jti          String            @unique @default(cuid())
  userId       String
  tenantId     String?
  expires      DateTime
  isRevoked    Boolean           @default(false)
  lastActivity DateTime          @default(now())
  ipAddress    String?
  deviceInfo   Json?
  membership   TenantMembership? @relation(fields: [tenantId, userId], references: [tenantId, userId])
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([userId, isRevoked, expires])
  @@map("sessions")
}

model MfaCredential {
  id              String            @id @default(cuid())
  userId          String
  type            MfaCredentialType @default(TOTP)
  label           String?
  secretEncrypted String
  isEnabled       Boolean           @default(false)
  verifiedAt      DateTime?
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  recoveryCodes   RecoveryCode[]
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, id])
  @@index([userId, isEnabled])
  @@map("mfa_credentials")
}

model RecoveryCode {
  id           String        @id @default(cuid())
  userId       String
  credentialId String
  codeHash     String        @unique
  usedAt       DateTime?
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  credential   MfaCredential @relation(fields: [userId, credentialId], references: [userId, id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("recovery_codes")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String?
  name        String
  scope       RoleScope        @default(TENANT)
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  assignments RoleAssignment[]
  permissions RolePermission[]
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, scope])
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  moduleKey   ModuleKey
  resource    String
  action      String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@unique([moduleKey, resource, action])
  @@index([moduleKey, resource])
  @@map("permissions")
}

model RoleAssignment {
  id                     String            @id @default(cuid())
  tenantId               String
  membershipId           String
  roleId                 String
  branchId               String?
  assignedByMembershipId String?
  validFrom              DateTime          @default(now())
  validUntil             DateTime?
  revokedAt              DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  assignedByMembership   TenantMembership? @relation("RoleAssignmentActor", fields: [tenantId, assignedByMembershipId], references: [tenantId, id])
  branch                 Branch?           @relation(fields: [tenantId, branchId], references: [tenantId, id])
  membership             TenantMembership  @relation("RoleAssignmentMember", fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  role                   Role              @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  tenant                 Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, membershipId, roleId, branchId])
  @@index([tenantId, membershipId, validFrom, validUntil])
  @@index([tenantId, roleId])
  @@index([tenantId, branchId])
  @@map("role_assignments")
}

model BranchMembership {
  id           String           @id @default(cuid())
  tenantId     String
  membershipId String
  branchId     String
  validFrom    DateTime         @default(now())
  validUntil   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  branch       Branch           @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  membership   TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, membershipId, branchId])
  @@index([tenantId, branchId])
  @@index([tenantId, membershipId, validFrom, validUntil])
  @@map("branch_memberships")
}

model AuditLog {
  id            String           @id @default(cuid())
  tenantId      String
  actorId       String
  branchId      String?
  action        String
  entity        String
  entityId      String?
  oldValues     Json?
  newValues     Json?
  ipAddress     String?
  correlationId String
  createdAt     DateTime         @default(now())
  actor         TenantMembership @relation("AuditLogActor", fields: [tenantId, actorId], references: [tenantId, id])
  branch        Branch?          @relation(fields: [tenantId, branchId], references: [tenantId, id])
  tenant        Tenant           @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, actorId, createdAt])
  @@index([tenantId, entity, entityId])
  @@index([tenantId, correlationId])
  @@map("audit_logs")
}

model SecurityEvent {
  id         String            @id @default(cuid())
  tenantId   String?
  userId     String?
  eventType  SecurityEventType
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime          @default(now())
  membership TenantMembership? @relation(fields: [tenantId, userId], references: [tenantId, userId])
  tenant     Tenant?           @relation(fields: [tenantId], references: [id])

  @@index([tenantId, eventType, createdAt])
  @@index([tenantId, userId, createdAt])
  @@index([ipAddress, createdAt])
  @@map("security_events")
}

model UserInvitation {
  id                    String           @id @default(cuid())
  tenantId              String
  email                 String
  tokenHash             String           @unique
  roleAssignments       Json
  branchIds             Json
  expiresAt             DateTime
  status                InvitationStatus @default(PENDING)
  invitedByMembershipId String
  acceptedAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  invitedByMembership   TenantMembership @relation("InvitationActor", fields: [tenantId, invitedByMembershipId], references: [tenantId, id])
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email, status])
  @@index([tenantId, expiresAt])
  @@map("user_invitations")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Member {
  id                 String              @id @default(cuid())
  tenantId           String
  branchId           String
  firstName          String
  lastName           String
  email              String?
  phone              String?
  birthDate          DateTime?
  status             MemberStatus        @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  invoices           Invoice[]
  branch             Branch              @relation(fields: [branchId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments           Payment[]
  sales              Sale[]
  specialistSessions SpecialistSession[]
  subscriptions      Subscription[]

  @@unique([tenantId, email])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@map("members")
}

model MembershipPlan {
  id            String         @id @default(cuid())
  tenantId      String
  name          String
  billingPeriod BillingPeriod
  price         Decimal        @db.Decimal(12, 2)
  currency      String         @default("MXN")
  accessRules   Json?
  status        BranchStatus   @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("membership_plans")
}

model Subscription {
  id                String                     @id @default(cuid())
  tenantId          String
  memberId          String
  planId            String
  status            SubscriptionStatus         @default(ACTIVE)
  externalReference String?
  startDate         DateTime
  endDate           DateTime?
  nextBillingDate   DateTime?
  autoRenew         Boolean                    @default(true)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  payments          Payment[]
  cancellations     SubscriptionCancellation[]
  pauses            SubscriptionPause[]
  member            Member                     @relation(fields: [memberId], references: [id])
  plan              MembershipPlan             @relation(fields: [planId], references: [id])
  tenant            Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalReference])
  @@index([tenantId, memberId])
  @@index([tenantId, status])
  @@index([tenantId, nextBillingDate])
  @@map("subscriptions")
}

model SubscriptionPause {
  id               String       @id @default(cuid())
  tenantId         String
  subscriptionId   String
  startDate        DateTime
  endDate          DateTime
  reason           String?
  approvedByUserId String?
  createdAt        DateTime     @default(now())
  approvedByUser   User?        @relation("SubscriptionPauseApprover", fields: [approvedByUserId], references: [id])
  subscription     Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, subscriptionId])
  @@map("subscription_pauses")
}

model SubscriptionCancellation {
  id                String       @id @default(cuid())
  tenantId          String
  subscriptionId    String
  reason            String?
  cancelledAt       DateTime     @default(now())
  cancelledByUserId String?
  cancelledByUser   User?        @relation("SubscriptionCancellationActor", fields: [cancelledByUserId], references: [id])
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, subscriptionId])
  @@map("subscription_cancellations")
}

model AccessDevice {
  id        String             @id @default(cuid())
  tenantId  String
  branchId  String
  name      String
  code      String
  type      AccessDeviceType
  status    AccessDeviceStatus @default(ONLINE)
  metadata  Json?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  branch    Branch             @relation(fields: [branchId], references: [id])
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@map("access_devices")
}

model Supplier {
  id        String       @id @default(cuid())
  tenantId  String
  name      String
  taxId     String?
  email     String?
  phone     String?
  status    BranchStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  invoices  Invoice[]
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("suppliers")
}

model ChartAccount {
  id           String             @id @default(cuid())
  tenantId     String
  code         String
  name         String
  type         AccountType
  parentId     String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  parent       ChartAccount?      @relation("ChartAccountTree", fields: [parentId], references: [id])
  children     ChartAccount[]     @relation("ChartAccountTree")
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalLines JournalEntryLine[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@map("chart_accounts")
}

model Invoice {
  id         String        @id @default(cuid())
  tenantId   String
  branchId   String?
  customerId String?
  supplierId String?
  type       InvoiceType
  status     InvoiceStatus @default(DRAFT)
  subtotal   Decimal       @db.Decimal(12, 2)
  tax        Decimal       @db.Decimal(12, 2)
  total      Decimal       @db.Decimal(12, 2)
  currency   String        @default("MXN")
  dueDate    DateTime?
  issuedAt   DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  items      InvoiceItem[]
  branch     Branch?       @relation(fields: [branchId], references: [id])
  customer   Member?       @relation(fields: [customerId], references: [id])
  supplier   Supplier?     @relation(fields: [supplierId], references: [id])
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments   Payment[]

  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  tenantId    String
  invoiceId   String
  productId   String?
  description String
  quantity    Decimal  @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  taxRate     Decimal  @db.Decimal(5, 2)
  total       Decimal  @db.Decimal(12, 2)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@map("invoice_items")
}

model Payment {
  id                String        @id @default(cuid())
  tenantId          String
  branchId          String?
  invoiceId         String?
  memberId          String?
  subscriptionId    String?
  saleId            String?
  paymentGatewayId  String?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("MXN")
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  provider          String?
  externalReference String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  branch            Branch?       @relation(fields: [branchId], references: [id])
  invoice           Invoice?      @relation(fields: [invoiceId], references: [id])
  member            Member?       @relation(fields: [memberId], references: [id])
  sale              Sale?         @relation(fields: [saleId], references: [id])
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id])
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, externalReference])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@index([tenantId, paidAt])
  @@map("payments")
}

model PaymentGatewayEvent {
  id              String    @id @default(cuid())
  tenantId        String
  provider        String
  externalEventId String
  eventType       String
  status          String
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([provider, externalEventId])
  @@index([tenantId, receivedAt])
  @@map("payment_gateway_events")
}

model JournalEntry {
  id          String             @id @default(cuid())
  tenantId    String
  sourceType  String
  sourceId    String
  entryDate   DateTime
  description String?
  status      JournalEntryStatus @default(DRAFT)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines       JournalEntryLine[]

  @@unique([tenantId, sourceType, sourceId])
  @@index([tenantId, entryDate])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String       @id @default(cuid())
  tenantId       String
  journalEntryId String
  accountId      String
  debit          Decimal      @default(0) @db.Decimal(12, 2)
  credit         Decimal      @default(0) @db.Decimal(12, 2)
  account        ChartAccount @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, journalEntryId])
  @@map("journal_entry_lines")
}

model ProductCategory {
  id        String            @id @default(cuid())
  tenantId  String
  name      String
  parentId  String?
  status    BranchStatus      @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  parent    ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("ProductCategoryTree")
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([tenantId, name])
  @@map("product_categories")
}

model Product {
  id                 String              @id @default(cuid())
  tenantId           String
  sku                String
  name               String
  categoryId         String?
  price              Decimal             @db.Decimal(12, 2)
  cost               Decimal             @db.Decimal(12, 2)
  taxRate            Decimal             @db.Decimal(5, 2)
  status             BranchStatus        @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  imageUrl           String?
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  invoiceItems       InvoiceItem[]
  category           ProductCategory?    @relation(fields: [categoryId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleItems          SaleItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, status])
  @@map("products")
}

model Warehouse {
  id                 String              @id @default(cuid())
  tenantId           String
  branchId           String
  name               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  branch             Branch              @relation(fields: [branchId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, name])
  @@index([tenantId, branchId])
  @@map("warehouses")
}

model InventoryItem {
  id               String    @id @default(cuid())
  tenantId         String
  warehouseId      String
  productId        String
  quantityOnHand   Decimal   @default(0) @db.Decimal(12, 2)
  quantityReserved Decimal   @default(0) @db.Decimal(12, 2)
  reorderPoint     Decimal   @default(0) @db.Decimal(12, 2)
  updatedAt        DateTime  @updatedAt
  product          Product   @relation(fields: [productId], references: [id])
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([tenantId, warehouseId, productId])
  @@index([tenantId, productId])
  @@map("inventory_items")
}

model InventoryMovement {
  id          String                @id @default(cuid())
  tenantId    String
  warehouseId String
  productId   String
  type        InventoryMovementType
  quantity    Decimal               @db.Decimal(12, 2)
  unitCost    Decimal?              @db.Decimal(12, 2)
  sourceType  String?
  sourceId    String?
  createdAt   DateTime              @default(now())
  product     Product               @relation(fields: [productId], references: [id])
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, warehouseId])
  @@index([tenantId, productId])
  @@index([tenantId, createdAt])
  @@map("inventory_movements")
}

model PosRegister {
  id           String         @id @default(cuid())
  tenantId     String
  branchId     String
  name         String
  status       RegisterStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  cashSessions CashSession[]
  branch       Branch         @relation(fields: [branchId], references: [id])
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, name])
  @@index([tenantId, branchId])
  @@map("pos_registers")
}

model CashSession {
  id             String            @id @default(cuid())
  tenantId       String
  registerId     String
  openedByUserId String
  closedByUserId String?
  openingAmount  Decimal           @db.Decimal(12, 2)
  closingAmount  Decimal?          @db.Decimal(12, 2)
  status         CashSessionStatus @default(OPEN)
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  closedByUser   User?             @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id])
  openedByUser   User              @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id])
  register       PosRegister       @relation(fields: [registerId], references: [id])
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales          Sale[]

  @@index([tenantId, status])
  @@index([tenantId, openedAt])
  @@map("cash_sessions")
}

model Sale {
  id            String      @id @default(cuid())
  tenantId      String
  branchId      String
  cashSessionId String
  memberId      String?
  status        SaleStatus  @default(DRAFT)
  subtotal      Decimal     @db.Decimal(12, 2)
  tax           Decimal     @db.Decimal(12, 2)
  total         Decimal     @db.Decimal(12, 2)
  paidAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  payments      Payment[]
  items         SaleItem[]
  branch        Branch      @relation(fields: [branchId], references: [id])
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id])
  member        Member?     @relation(fields: [memberId], references: [id])
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@index([tenantId, paidAt])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(cuid())
  tenantId  String
  saleId    String
  productId String
  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)
  product   Product @relation(fields: [productId], references: [id])
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, saleId])
  @@map("sale_items")
}

model Position {
  id         String     @id @default(cuid())
  tenantId   String
  name       String
  department String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  employees  Employee[]
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("positions")
}

model Employee {
  id                String             @id @default(cuid())
  tenantId          String
  branchId          String
  firstName         String
  lastName          String
  email             String?
  phone             String?
  positionId        String?
  status            BranchStatus       @default(ACTIVE)
  hireDate          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  attendanceRecords AttendanceRecord[]
  contracts         EmployeeContract[]
  branch            Branch             @relation(fields: [branchId], references: [id])
  position          Position?          @relation(fields: [positionId], references: [id])
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollItems      PayrollItem[]
  specialists       Specialist[]
  timeClocks        TimeClock[]
  membership        TenantMembership?

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@map("employees")
}

model EmployeeContract {
  id                 String                 @id @default(cuid())
  tenantId           String
  employeeId         String
  type               EmploymentContractType
  salary             Decimal?               @db.Decimal(12, 2)
  hourlyRate         Decimal?               @db.Decimal(12, 2)
  commissionSchemeId String?
  startDate          DateTime
  endDate            DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  employee           Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@map("employee_contracts")
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  tenantId   String
  employeeId String
  branchId   String
  clockIn    DateTime
  clockOut   DateTime?
  source     AttendanceSource @default(MANUAL)
  createdAt  DateTime         @default(now())
  branch     Branch           @relation(fields: [branchId], references: [id])
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@index([tenantId, branchId])
  @@index([tenantId, clockIn])
  @@map("attendance_records")
}

model TimeClock {
  id         String           @id @default(cuid())
  tenantId   String
  employeeId String
  branchId   String
  clockIn    DateTime         @default(now())
  clockOut   DateTime?
  source     AttendanceSource @default(APP)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  branch     Branch           @relation(fields: [branchId], references: [id])
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@index([tenantId, branchId])
  @@index([tenantId, clockIn])
  @@index([tenantId, clockOut])
  @@map("time_clocks")
}

model BranchBudget {
  id               String   @id @default(cuid())
  tenantId         String
  branchId         String
  periodStart      DateTime
  periodEnd        DateTime
  payrollBudget    Decimal  @db.Decimal(12, 2)
  specialistBudget Decimal  @default(0) @db.Decimal(12, 2)
  operationsBudget Decimal  @default(0) @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  branch           Branch   @relation(fields: [branchId], references: [id])
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, periodStart, periodEnd])
  @@index([tenantId, branchId])
  @@index([tenantId, periodStart, periodEnd])
  @@map("branch_budgets")
}

model PayrollPeriod {
  id        String        @id @default(cuid())
  tenantId  String
  startDate DateTime
  endDate   DateTime
  status    PayrollStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  items     PayrollItem[]
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, startDate, endDate])
  @@index([tenantId, status])
  @@map("payroll_periods")
}

model PayrollItem {
  id               String        @id @default(cuid())
  tenantId         String
  payrollPeriodId  String
  employeeId       String
  baseAmount       Decimal       @db.Decimal(12, 2)
  overtimeAmount   Decimal       @default(0) @db.Decimal(12, 2)
  commissionAmount Decimal       @default(0) @db.Decimal(12, 2)
  deductions       Decimal       @default(0) @db.Decimal(12, 2)
  netAmount        Decimal       @db.Decimal(12, 2)
  employee         Employee      @relation(fields: [employeeId], references: [id])
  payrollPeriod    PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, payrollPeriodId, employeeId])
  @@map("payroll_items")
}

model Specialist {
  id          String                 @id @default(cuid())
  tenantId    String
  branchId    String?
  employeeId  String?
  name        String
  specialty   String
  type        SpecialistType
  status      BranchStatus           @default(ACTIVE)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  commissions SpecialistCommission[]
  contracts   SpecialistContract[]
  services    SpecialistService[]
  sessions    SpecialistSession[]
  settlements SpecialistSettlement[]
  branch      Branch?                @relation(fields: [branchId], references: [id])
  employee    Employee?              @relation(fields: [employeeId], references: [id])
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@map("specialists")
}

model SpecialistContract {
  id              String                  @id @default(cuid())
  tenantId        String
  specialistId    String
  model           SpecialistContractModel
  fixedRentAmount Decimal?                @db.Decimal(12, 2)
  commissionRate  Decimal?                @db.Decimal(5, 2)
  startDate       DateTime
  endDate         DateTime?
  status          BranchStatus            @default(ACTIVE)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  commissions     SpecialistCommission[]
  specialist      Specialist              @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, specialistId])
  @@map("specialist_contracts")
}

model SpecialistService {
  id              String              @id @default(cuid())
  tenantId        String
  specialistId    String
  name            String
  durationMinutes Int
  price           Decimal             @db.Decimal(12, 2)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  specialist      Specialist          @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions        SpecialistSession[]

  @@unique([tenantId, specialistId, name])
  @@map("specialist_services")
}

model SpecialistSession {
  id              String                     @id @default(cuid())
  tenantId        String
  specialistId    String
  memberId        String
  serviceId       String
  branchId        String
  status          SpecialistSessionStatus    @default(SCHEDULED)
  scheduledAt     DateTime
  completedAt     DateTime?
  price           Decimal                    @db.Decimal(12, 2)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  commissions     SpecialistCommission[]
  branch          Branch                     @relation(fields: [branchId], references: [id])
  member          Member                     @relation(fields: [memberId], references: [id])
  service         SpecialistService          @relation(fields: [serviceId], references: [id])
  specialist      Specialist                 @relation(fields: [specialistId], references: [id])
  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settlementItems SpecialistSettlementItem[]

  @@index([tenantId, specialistId])
  @@index([tenantId, memberId])
  @@index([tenantId, scheduledAt])
  @@map("specialist_sessions")
}

model SpecialistSettlement {
  id               String                     @id @default(cuid())
  tenantId         String
  specialistId     String
  periodStart      DateTime
  periodEnd        DateTime
  grossAmount      Decimal                    @db.Decimal(12, 2)
  rentAmount       Decimal                    @default(0) @db.Decimal(12, 2)
  commissionAmount Decimal                    @default(0) @db.Decimal(12, 2)
  netPayout        Decimal                    @db.Decimal(12, 2)
  status           SettlementStatus           @default(DRAFT)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  commissions      SpecialistCommission[]
  items            SpecialistSettlementItem[]
  specialist       Specialist                 @relation(fields: [specialistId], references: [id])
  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, specialistId])
  @@index([tenantId, status])
  @@map("specialist_settlements")
}

model SpecialistSettlementItem {
  id           String               @id @default(cuid())
  tenantId     String
  settlementId String
  sessionId    String?
  concept      String
  amount       Decimal              @db.Decimal(12, 2)
  session      SpecialistSession?   @relation(fields: [sessionId], references: [id])
  settlement   SpecialistSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, settlementId])
  @@map("specialist_settlement_items")
}

model SpecialistCommission {
  id               String                @id @default(cuid())
  tenantId         String
  specialistId     String
  contractId       String?
  sessionId        String?
  settlementId     String?
  grossAmount      Decimal               @db.Decimal(12, 2)
  commissionRate   Decimal?              @db.Decimal(5, 2)
  rentProration    Decimal               @default(0) @db.Decimal(12, 2)
  commissionAmount Decimal               @default(0) @db.Decimal(12, 2)
  netAmount        Decimal               @db.Decimal(12, 2)
  calculatedAt     DateTime              @default(now())
  createdAt        DateTime              @default(now())
  contract         SpecialistContract?   @relation(fields: [contractId], references: [id])
  session          SpecialistSession?    @relation(fields: [sessionId], references: [id])
  settlement       SpecialistSettlement? @relation(fields: [settlementId], references: [id])
  specialist       Specialist            @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sessionId])
  @@index([tenantId, specialistId])
  @@index([tenantId, settlementId])
  @@map("specialist_commissions")
}

model OutboxEvent {
  id            String       @id @default(cuid())
  tenantId      String
  type          String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  processedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, availableAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@map("outbox_events")
}

