generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum PlanInterval {
  MONTHLY
  YEARLY
}

enum ModuleKey {
  DASHBOARD
  MEMBERSHIPS
  ACCESS
  FINANCE
  POS
  INVENTORY
  HR
  MARKETING
  SPECIALISTS
  ADMIN
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum RoleScope {
  SYSTEM
  TENANT
  BRANCH
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  CANCELLED
}

enum BillingPeriod {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum AccessDeviceType {
  TURNSTILE
  BIOMETRIC
  QR_SCANNER
}

enum AccessDeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum AccountType {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
  EQUITY
}

enum InvoiceType {
  RECEIVABLE
  PAYABLE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  GATEWAY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum InventoryMovementType {
  PURCHASE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  SHRINKAGE
}

enum RegisterStatus {
  ACTIVE
  INACTIVE
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum SaleStatus {
  DRAFT
  PAID
  CANCELLED
  REFUNDED
}

enum EmploymentContractType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
}

enum AttendanceSource {
  MANUAL
  BIOMETRIC
  APP
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum SpecialistType {
  INTERNAL
  EXTERNAL
  CLINIC
}

enum SpecialistContractModel {
  FIXED_RENT
  COMMISSION
  HYBRID
}

enum SpecialistSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SettlementStatus {
  DRAFT
  APPROVED
  PAID
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  VOID
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  legalName   String?
  taxId       String?
  status      TenantStatus @default(ACTIVE)
  planId      String?
  plan        SaasPlan?    @relation(fields: [planId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  modules                 TenantModule[]
  branches                Branch[]
  users                   User[]
  roles                   Role[]
  members                 Member[]
  membershipPlans         MembershipPlan[]
  subscriptions           Subscription[]
  subscriptionPauses      SubscriptionPause[]
  subscriptionCancellations SubscriptionCancellation[]
  accessDevices           AccessDevice[]
  suppliers               Supplier[]
  chartAccounts           ChartAccount[]
  invoices                Invoice[]
  invoiceItems            InvoiceItem[]
  payments                Payment[]
  paymentGatewayEvents    PaymentGatewayEvent[]
  journalEntries          JournalEntry[]
  journalEntryLines       JournalEntryLine[]
  productCategories       ProductCategory[]
  products                Product[]
  warehouses              Warehouse[]
  inventoryItems          InventoryItem[]
  inventoryMovements      InventoryMovement[]
  posRegisters            PosRegister[]
  cashSessions            CashSession[]
  sales                   Sale[]
  saleItems               SaleItem[]
  positions               Position[]
  employees               Employee[]
  employeeContracts       EmployeeContract[]
  attendanceRecords       AttendanceRecord[]
  payrollPeriods          PayrollPeriod[]
  payrollItems            PayrollItem[]
  specialists             Specialist[]
  specialistContracts     SpecialistContract[]
  specialistServices      SpecialistService[]
  specialistSessions      SpecialistSession[]
  specialistSettlements   SpecialistSettlement[]
  specialistSettlementItems SpecialistSettlementItem[]
  outboxEvents            OutboxEvent[]

  @@index([status])
  @@map("tenants")
}

model SaasPlan {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  price       Decimal      @db.Decimal(12, 2)
  currency    String       @default("MXN")
  interval    PlanInterval @default(MONTHLY)
  limits      Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenants Tenant[]

  @@map("saas_plans")
}

model TenantModule {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleKey ModuleKey
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, moduleKey])
  @@index([tenantId, enabled])
  @@map("tenant_modules")
}

model Branch {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String
  address   Json?
  timezone  String       @default("America/Mexico_City")
  status    BranchStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users              User[]
  members            Member[]
  accessDevices      AccessDevice[]
  invoices           Invoice[]
  payments           Payment[]
  warehouses         Warehouse[]
  posRegisters       PosRegister[]
  sales              Sale[]
  employees          Employee[]
  attendanceRecords  AttendanceRecord[]
  specialists        Specialist[]
  specialistSessions SpecialistSession[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("branches")
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id])
  email        String
  passwordHash String?
  employeeId   String?    @unique
  employee     Employee?  @relation(fields: [employeeId], references: [id])
  status       UserStatus @default(INVITED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles                       UserRole[]
  approvedSubscriptionPauses  SubscriptionPause[] @relation("SubscriptionPauseApprover")
  cancelledSubscriptions      SubscriptionCancellation[] @relation("SubscriptionCancellationActor")
  openedCashSessions          CashSession[] @relation("CashSessionOpenedBy")
  closedCashSessions          CashSession[] @relation("CashSessionClosedBy")

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, branchId])
  @@map("users")
}

model Role {
  id          String    @id @default(cuid())
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  scope       RoleScope @default(TENANT)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId, scope])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branchId  String?
  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([branchId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Member {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch       @relation(fields: [branchId], references: [id])
  firstName String
  lastName  String
  email     String?
  phone     String?
  birthDate DateTime?
  status    MemberStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  subscriptions      Subscription[]
  invoices           Invoice[]
  payments           Payment[]
  sales              Sale[]
  specialistSessions SpecialistSession[]

  @@unique([tenantId, email])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@map("members")
}

model MembershipPlan {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  billingPeriod BillingPeriod
  price         Decimal       @db.Decimal(12, 2)
  currency      String        @default("MXN")
  accessRules   Json?
  status        BranchStatus  @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  subscriptions Subscription[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("membership_plans")
}

model Subscription {
  id                  String             @id @default(cuid())
  tenantId            String
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId            String
  member              Member             @relation(fields: [memberId], references: [id])
  planId              String
  plan                MembershipPlan     @relation(fields: [planId], references: [id])
  status              SubscriptionStatus @default(ACTIVE)
  externalReference   String?
  startDate           DateTime
  endDate             DateTime?
  nextBillingDate     DateTime?
  autoRenew           Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  pauses        SubscriptionPause[]
  cancellations SubscriptionCancellation[]
  payments      Payment[]

  @@unique([tenantId, externalReference])
  @@index([tenantId, memberId])
  @@index([tenantId, status])
  @@index([tenantId, nextBillingDate])
  @@map("subscriptions")
}

model SubscriptionPause {
  id               String       @id @default(cuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId   String
  subscription     Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  startDate        DateTime
  endDate          DateTime
  reason           String?
  approvedByUserId String?
  approvedByUser   User?        @relation("SubscriptionPauseApprover", fields: [approvedByUserId], references: [id])
  createdAt        DateTime     @default(now())

  @@index([tenantId, subscriptionId])
  @@map("subscription_pauses")
}

model SubscriptionCancellation {
  id                String       @id @default(cuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId    String
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  reason            String?
  cancelledAt       DateTime     @default(now())
  cancelledByUserId String?
  cancelledByUser   User?        @relation("SubscriptionCancellationActor", fields: [cancelledByUserId], references: [id])

  @@index([tenantId, subscriptionId])
  @@map("subscription_cancellations")
}

model AccessDevice {
  id        String             @id @default(cuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch             @relation(fields: [branchId], references: [id])
  name      String
  code      String
  type      AccessDeviceType
  status    AccessDeviceStatus @default(ONLINE)
  metadata  Json?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@map("access_devices")
}

model Supplier {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  taxId     String?
  email     String?
  phone     String?
  status    BranchStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  invoices Invoice[]

  @@index([tenantId, status])
  @@map("suppliers")
}

model ChartAccount {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  type      AccountType
  parentId  String?
  parent    ChartAccount? @relation("ChartAccountTree", fields: [parentId], references: [id])
  children  ChartAccount[] @relation("ChartAccountTree")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  journalLines JournalEntryLine[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@map("chart_accounts")
}

model Invoice {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch?       @relation(fields: [branchId], references: [id])
  customerId String?
  customer   Member?       @relation(fields: [customerId], references: [id])
  supplierId String?
  supplier   Supplier?     @relation(fields: [supplierId], references: [id])
  type       InvoiceType
  status     InvoiceStatus @default(DRAFT)
  subtotal   Decimal       @db.Decimal(12, 2)
  tax        Decimal       @db.Decimal(12, 2)
  total      Decimal       @db.Decimal(12, 2)
  currency   String        @default("MXN")
  dueDate    DateTime?
  issuedAt   DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  description String
  quantity    Decimal  @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  taxRate     Decimal  @db.Decimal(5, 2)
  total       Decimal  @db.Decimal(12, 2)

  @@index([tenantId, invoiceId])
  @@map("invoice_items")
}

model Payment {
  id                 String        @id @default(cuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId           String?
  branch             Branch?       @relation(fields: [branchId], references: [id])
  invoiceId          String?
  invoice            Invoice?      @relation(fields: [invoiceId], references: [id])
  memberId           String?
  member             Member?       @relation(fields: [memberId], references: [id])
  subscriptionId     String?
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id])
  saleId             String?
  sale               Sale?         @relation(fields: [saleId], references: [id])
  paymentGatewayId   String?
  amount             Decimal       @db.Decimal(12, 2)
  currency           String        @default("MXN")
  method             PaymentMethod
  status             PaymentStatus @default(PENDING)
  provider           String?
  externalReference  String?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([tenantId, provider, externalReference])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@index([tenantId, paidAt])
  @@map("payments")
}

model PaymentGatewayEvent {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider        String
  externalEventId String
  eventType       String
  status          String
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  @@unique([provider, externalEventId])
  @@index([tenantId, receivedAt])
  @@map("payment_gateway_events")
}

model JournalEntry {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceType  String
  sourceId    String
  entryDate   DateTime
  description String?
  status      JournalEntryStatus @default(DRAFT)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  lines JournalEntryLine[]

  @@index([tenantId, entryDate])
  @@index([tenantId, sourceType, sourceId])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        ChartAccount @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0) @db.Decimal(12, 2)
  credit         Decimal      @default(0) @db.Decimal(12, 2)

  @@index([tenantId, journalEntryId])
  @@map("journal_entry_lines")
}

model ProductCategory {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?
  parent    ProductCategory? @relation("ProductCategoryTree", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("ProductCategoryTree")
  status    BranchStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  products Product[]

  @@unique([tenantId, name])
  @@map("product_categories")
}

model Product {
  id         String          @id @default(cuid())
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku        String
  name       String
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])
  price      Decimal         @db.Decimal(12, 2)
  cost       Decimal         @db.Decimal(12, 2)
  taxRate    Decimal         @db.Decimal(5, 2)
  status     BranchStatus    @default(ACTIVE)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  invoiceItems       InvoiceItem[]
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, status])
  @@map("products")
}

model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]

  @@unique([tenantId, branchId, name])
  @@index([tenantId, branchId])
  @@map("warehouses")
}

model InventoryItem {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouseId      String
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])
  productId        String
  product          Product   @relation(fields: [productId], references: [id])
  quantityOnHand   Decimal   @default(0) @db.Decimal(12, 2)
  quantityReserved Decimal   @default(0) @db.Decimal(12, 2)
  reorderPoint     Decimal   @default(0) @db.Decimal(12, 2)
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, warehouseId, productId])
  @@index([tenantId, productId])
  @@map("inventory_items")
}

model InventoryMovement {
  id          String                @id @default(cuid())
  tenantId    String
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id])
  productId   String
  product     Product               @relation(fields: [productId], references: [id])
  type        InventoryMovementType
  quantity    Decimal               @db.Decimal(12, 2)
  unitCost    Decimal?              @db.Decimal(12, 2)
  sourceType  String?
  sourceId    String?
  createdAt   DateTime              @default(now())

  @@index([tenantId, warehouseId])
  @@index([tenantId, productId])
  @@index([tenantId, createdAt])
  @@map("inventory_movements")
}

model PosRegister {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch         @relation(fields: [branchId], references: [id])
  name      String
  status    RegisterStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  cashSessions CashSession[]

  @@unique([tenantId, branchId, name])
  @@index([tenantId, branchId])
  @@map("pos_registers")
}

model CashSession {
  id              String            @id @default(cuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registerId      String
  register        PosRegister       @relation(fields: [registerId], references: [id])
  openedByUserId  String
  openedByUser    User              @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id])
  closedByUserId  String?
  closedByUser    User?             @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id])
  openingAmount   Decimal           @db.Decimal(12, 2)
  closingAmount   Decimal?          @db.Decimal(12, 2)
  status          CashSessionStatus @default(OPEN)
  openedAt        DateTime          @default(now())
  closedAt        DateTime?

  sales Sale[]

  @@index([tenantId, status])
  @@index([tenantId, openedAt])
  @@map("cash_sessions")
}

model Sale {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch       @relation(fields: [branchId], references: [id])
  cashSessionId String
  cashSession   CashSession  @relation(fields: [cashSessionId], references: [id])
  memberId      String?
  member        Member?      @relation(fields: [memberId], references: [id])
  status        SaleStatus   @default(DRAFT)
  subtotal      Decimal      @db.Decimal(12, 2)
  tax           Decimal      @db.Decimal(12, 2)
  total         Decimal      @db.Decimal(12, 2)
  paidAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items    SaleItem[]
  payments Payment[]

  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@index([tenantId, paidAt])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  @@index([tenantId, saleId])
  @@map("sale_items")
}

model Position {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  department String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employees Employee[]

  @@unique([tenantId, name])
  @@map("positions")
}

model Employee {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch       @relation(fields: [branchId], references: [id])
  firstName  String
  lastName   String
  email      String?
  phone      String?
  positionId String?
  position   Position?    @relation(fields: [positionId], references: [id])
  status     BranchStatus @default(ACTIVE)
  hireDate   DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user              User?
  contracts         EmployeeContract[]
  attendanceRecords AttendanceRecord[]
  payrollItems      PayrollItem[]
  specialists       Specialist[]

  @@unique([tenantId, email])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@map("employees")
}

model EmployeeContract {
  id                 String                 @id @default(cuid())
  tenantId           String
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type               EmploymentContractType
  salary             Decimal?               @db.Decimal(12, 2)
  hourlyRate         Decimal?               @db.Decimal(12, 2)
  commissionSchemeId String?
  startDate          DateTime
  endDate            DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([tenantId, employeeId])
  @@map("employee_contracts")
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch           @relation(fields: [branchId], references: [id])
  clockIn    DateTime
  clockOut   DateTime?
  source     AttendanceSource @default(MANUAL)
  createdAt  DateTime         @default(now())

  @@index([tenantId, employeeId])
  @@index([tenantId, branchId])
  @@index([tenantId, clockIn])
  @@map("attendance_records")
}

model PayrollPeriod {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  status    PayrollStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  items PayrollItem[]

  @@unique([tenantId, startDate, endDate])
  @@index([tenantId, status])
  @@map("payroll_periods")
}

model PayrollItem {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  baseAmount      Decimal       @db.Decimal(12, 2)
  overtimeAmount  Decimal       @default(0) @db.Decimal(12, 2)
  commissionAmount Decimal      @default(0) @db.Decimal(12, 2)
  deductions      Decimal       @default(0) @db.Decimal(12, 2)
  netAmount       Decimal       @db.Decimal(12, 2)

  @@unique([tenantId, payrollPeriodId, employeeId])
  @@map("payroll_items")
}

model Specialist {
  id         String         @id @default(cuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch?        @relation(fields: [branchId], references: [id])
  employeeId String?
  employee   Employee?      @relation(fields: [employeeId], references: [id])
  name       String
  specialty  String
  type       SpecialistType
  status     BranchStatus   @default(ACTIVE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  contracts   SpecialistContract[]
  services    SpecialistService[]
  sessions    SpecialistSession[]
  settlements SpecialistSettlement[]

  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@map("specialists")
}

model SpecialistContract {
  id              String                  @id @default(cuid())
  tenantId        String
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  specialistId    String
  specialist      Specialist              @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  model           SpecialistContractModel
  fixedRentAmount Decimal?                @db.Decimal(12, 2)
  commissionRate  Decimal?                @db.Decimal(5, 2)
  startDate       DateTime
  endDate         DateTime?
  status          BranchStatus            @default(ACTIVE)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([tenantId, specialistId])
  @@map("specialist_contracts")
}

model SpecialistService {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  specialistId    String
  specialist      Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int
  price           Decimal    @db.Decimal(12, 2)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions SpecialistSession[]

  @@unique([tenantId, specialistId, name])
  @@map("specialist_services")
}

model SpecialistSession {
  id           String                  @id @default(cuid())
  tenantId     String
  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  specialistId String
  specialist   Specialist              @relation(fields: [specialistId], references: [id])
  memberId     String
  member       Member                  @relation(fields: [memberId], references: [id])
  serviceId    String
  service      SpecialistService       @relation(fields: [serviceId], references: [id])
  branchId     String
  branch       Branch                  @relation(fields: [branchId], references: [id])
  status       SpecialistSessionStatus @default(SCHEDULED)
  scheduledAt  DateTime
  completedAt  DateTime?
  price        Decimal                 @db.Decimal(12, 2)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  settlementItems SpecialistSettlementItem[]

  @@index([tenantId, specialistId])
  @@index([tenantId, memberId])
  @@index([tenantId, scheduledAt])
  @@map("specialist_sessions")
}

model SpecialistSettlement {
  id               String           @id @default(cuid())
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  specialistId     String
  specialist       Specialist       @relation(fields: [specialistId], references: [id])
  periodStart      DateTime
  periodEnd        DateTime
  grossAmount      Decimal          @db.Decimal(12, 2)
  rentAmount       Decimal          @default(0) @db.Decimal(12, 2)
  commissionAmount Decimal          @default(0) @db.Decimal(12, 2)
  netPayout        Decimal          @db.Decimal(12, 2)
  status           SettlementStatus @default(DRAFT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  items SpecialistSettlementItem[]

  @@index([tenantId, specialistId])
  @@index([tenantId, status])
  @@map("specialist_settlements")
}

model SpecialistSettlementItem {
  id           String                @id @default(cuid())
  tenantId     String
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settlementId String
  settlement   SpecialistSettlement  @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  sessionId    String?
  session      SpecialistSession?    @relation(fields: [sessionId], references: [id])
  concept      String
  amount       Decimal               @db.Decimal(12, 2)

  @@index([tenantId, settlementId])
  @@map("specialist_settlement_items")
}

model OutboxEvent {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type          String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  processedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tenantId, status, availableAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@map("outbox_events")
}
